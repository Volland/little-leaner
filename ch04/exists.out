-- ANCHOR: check
∃ c, Eats c fish : Prop
-- ANCHOR_END: check
-- ANCHOR: fish_eaten_1
⊢ Eats heron fish
-- ANCHOR_END: fish_eaten_1
-- ANCHOR: print
theorem fish_eaten : ∃ c, Eats c fish :=
Exists.intro heron Eats.heron_fish
-- ANCHOR_END: print
-- ANCHOR: duck_1
⊢ Swims duck ∧ Flies duck
-- ANCHOR_END: duck_1
